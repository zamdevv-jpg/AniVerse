# Alamat sumber data (Otakudesu)
OTAKUDESU_BASE_URL=https://otakudesu.or.at
DORONIME_BASE_URL=https://doronime.id

# Identitas situs
SITE_NAME=AniVerse
SITE_TAGLINE=Nonton anime sub indo, update tiap hari.
SITE_DESCRIPTION=AniVerse adalah katalog streaming anime subtitle Indonesia. Data dan video berasal dari pihak ketiga.

# Server
HOST=127.0.0.1
PORT=3001

# Folder aset statis (relatif terhadap direktori kerja)
STATIC_DIR=static

# Level log (RUST_LOG) — contoh: otakunime=debug,tower_http=info
RUST_LOG=otakunime=info,tower_http=warn
