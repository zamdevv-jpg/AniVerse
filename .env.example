# Alamat sumber data utama
NIMEGAMI_BASE_URL=https://nimegami.id

# MyAnimeList weekly schedule feed (the feed reads public MAL schedule pages)
MAL_SCHEDULE_API=https://jikan.lucashdo.com/v1/schedules

# Identitas situs
SITE_NAME=AniVerse
SITE_TAGLINE=Nonton anime sub indo, update tiap hari.
SITE_DESCRIPTION=AniVerse adalah katalog streaming anime subtitle Indonesia. Data dan video berasal dari pihak ketiga.

# Server
HOST=127.0.0.1
PORT=3001

# Folder aset statis (relatif terhadap direktori kerja)
STATIC_DIR=static

# Supabase project settings. Use the publishable/anon key only; never put the service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Level log (RUST_LOG) — contoh: otakunime=debug,tower_http=info
RUST_LOG=otakunime=info,tower_http=warn
