{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniVerse",
  "version": "0.1.1",
  "identifier": "com.otakunime.desktop",
  "build": {
    "frontendDist": "../static",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "AniVerse",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1001
    }
  }
}
